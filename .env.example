# Choose one provider: anthropic | bedrock
LLM_PROVIDER=anthropic

# --- anthropic block (model IDs: platform.claude.com Models overview) ---
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-sonnet-5-5
JUDGE_MODEL=claude-sonnet-5-5

# --- bedrock block (comment out the anthropic block above and uncomment this) ---
# AWS credentials come from the standard AWS chain, not this file, e.g.:
#   AWS_PROFILE / aws sso login, AWS_ACCESS_KEY_ID + AWS_SECRET_ACCESS_KEY (+ AWS_SESSION_TOKEN),
#   AWS_BEARER_TOKEN_BEDROCK, or an IAM role.
# AWS_REGION=us-east-1
# AGENT_MODEL=us.anthropic.claude-sonnet-5-5
# JUDGE_MODEL=us.anthropic.claude-sonnet-5-5

AGENT_MAX_TURNS=12
DATA_PATH=data/policies.json
EVAL_PATH=data/eval.json
GT_PATH=data/gt.json
OUT_DIR=out
ARIZE_SPACE_ID=U3BhY2U6NTM3Mjg6THVGdw==
ARIZE_API_KEY=
ARIZE_PROJECT_NAME=insurance-pricing-agent

# Agent identity stamped on every span. Set AGENT_ID/AGENT_VERSION in the deployment environment to replace these.
AGENT_ID=
AGENT_VERSION=0.1.0
